{
  "name": "erp-ai-backend",
  "version": "1.0.0",
  "description": "ERP-AI Backend System - Express.js with MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js && docker-compose up -d",
    "seed:permissions": "node seeders/permission.seeder.js",
    "seed:roles": "node seeders/role.seeder.js",
    "seed:products": "node seeders/product.seeder.js",
    "seed:warehouses": "node seeders/warehouse.seeder.js",
    "seed:inventory": "node seeders/inventory.seeder.js",
    "seed:orders": "node seeders/order.seeder.js",
    "seed:all": "node seeders/runAllSeeders.js"
  },
  "keywords": [
    "erp",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "authentication"
  ],
  "author": "ERP-AI Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.6.3",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "express-validator": "^7.0.1",
    "express-rate-limit": "^7.1.5",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
