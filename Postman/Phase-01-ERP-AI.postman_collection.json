                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@erp-system.com\",\n  \"password\": \"AnotherPass123!\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"roleCode\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
